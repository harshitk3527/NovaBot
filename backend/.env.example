DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/presidio
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ENV=development
MAX_UPLOAD_SIZE_BYTES=10485760
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
INGESTION_CHUNK_TOKENS=650
INGESTION_CHUNK_OVERLAP_TOKENS=100
STALENESS_JOB_INTERVAL_SECONDS=60
RETRIEVAL_SIMILARITY_CUTOFF=0.75
RETRIEVAL_DEFAULT_K=8
OPENAI_TIMEOUT_SECONDS=30
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=600
LLM_MAX_RETRIES=3
REWRITER_MODEL=gpt-4o-mini
REWRITER_MAX_TOKENS=120
MAX_REWRITTEN_QUESTION_LENGTH=1000
MEMORY_WINDOW_MESSAGES=8
CACHE_DISTANCE_THRESHOLD=0.1
CACHE_TTL_SECONDS=3600
CACHE_PROMPT_VERSION=v1
CACHE_INDEX_NAME=presidio_semantic_cache
MAX_MESSAGE_LENGTH=4000
MAX_OUTPUT_LENGTH=10000
PROMPT_CANARY=PRESIDIO_SYSTEM_CANARY_7F3A
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_SIZE_BYTES=12582912
CHAT_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_TOKEN_BUDGET=100000
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_SECONDS=900
PII_REDACTION_ENABLED=true
MODERATION_ENABLED=true
SCOPE_CLASSIFIER_ENABLED=true
SCOPE_MODEL=gpt-4o-mini
